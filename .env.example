# ── LLM Provider & Model Selection ────────────────────────────────────
# "local" = deterministic regex extractor (default, zero-cost, zero AI egress)
# "gemini" = Google Gemini AI-powered extraction
LLM_PROVIDER=local
GEMINI_API_KEY=

# ── Gemini Models (Stable GA IDs — verified responding 2026-10-10) ──────
# Do NOT use gemini-2.5-* (retired 2026-10-16) or gemini-3.8-flash (preview, removed).
# Verified responding IDs (cheapest working Flash-Lite model used for polish):
GEMINI_MODEL_VISION=gemini-3.5-flash
GEMINI_MODEL_DRAFT=gemini-3.5-flash
GEMINI_MODEL_POLISH=gemini-3.5-flash-lite

# ── Voice Transcription & Privacy Modes ────────────────────────────────
# "local"  = 100% on-device faster-whisper (CTranslate2 int8 CPU), zero audio egress (Default)
# "cloud"  = Gemini Multimodal Audio API
# "hybrid" = Cloud first with automatic local faster-whisper fallback
TRANSCRIPTION_MODE=local
WHISPER_MODEL_SIZE=base

# ── Security, CORS & Authentication ────────────────────────────────────
# Comma-separated allowed origins (no wildcard regex allowed)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://rounds-ai-app.firebaseapp.com,https://rounds-ai-app.web.app

# Set to "true" to require API key / bearer token in production
REQUIRE_AUTH=false
API_KEY=
AUTH_TOKEN=

# ── API Endpoint ───────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
# ⚠️  DEMO USE ONLY: NEXT_PUBLIC_API_KEY is visible in the browser client bundle
#    and network inspector. It is intended for hackathon and local demo use only.
#    Production deployments must use session cookies or server-side OAuth/BFF tokens.
NEXT_PUBLIC_API_KEY=

# ── Supabase (Database Persistence) ────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co

# SUPABASE_SERVICE_ROLE_KEY — server-side ONLY, never in NEXT_PUBLIC_ variables
# or frontend code. Bypasses Row Level Security; keep this secret.
# When set, it is preferred over SUPABASE_ANON_KEY for all backend DB calls.
SUPABASE_SERVICE_ROLE_KEY=

# SUPABASE_ANON_KEY — safe for client-side use, subject to Row Level Security.
# Used as fallback when SUPABASE_SERVICE_ROLE_KEY is not set.
SUPABASE_ANON_KEY=

# ── Firebase (Client Authentication) ───────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# ── Demo & Test Modes ──────────────────────────────────────────────────
# DEMO_MODE=true  — enables synthetic demo data in analytics and fallback vision.
#   Every demo value is labeled "[DEMO DATA]". Off by default.
DEMO_MODE=false

# TEST_MODE=true  — skips all Supabase DB writes/reads for this server instance.
#   Displays a prominent warning in logs, /health, and the UI header.
#   Use in CI / test environments only; never in production.
#   NOTE: A client sending X-Test-Mode: true header has NO effect unless the
#   server itself is started with TEST_MODE=true.
TEST_MODE=false
